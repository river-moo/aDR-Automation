# ===== SCP 접속 (환경마다 반드시 수정) =====
# SCP 관리 IP 또는 https://IP:PORT
SCP_HOST=192.168.0.210

# 인증 방식: auto(AK/SK 있으면 ec2) | ec2 | token
SCP_AUTH=auto

# EC2 인증용 AK/SK (SCP 기술지원에서 발급)
SCP_AK=
SCP_SK=

# token 인증용 계정 (SCP_AUTH=token 일 때만)
SCP_USER=admin
SCP_PASS=

# ===== 보통은 그대로 =====
# 사설 인증서면 0, 정식 인증서면 1
SCP_VERIFY_TLS=0
SCP_TIMEOUT=30
# EC2 서명 파라미터 (SCP 문서 예제 값). 01 점검에서 실패하면 바꿔봄
SCP_EC2_REGION=cn-south-1
SCP_EC2_SERVICE=sdk-api
# 쿼리스트링을 서명에 포함할지. SCP 6.11.3 실측: 0 (문서 예제와 동일). 01 점검이 1로 바꾸라고 하면 1
SCP_EC2_SIGN_QUERY=0

# ===== 콘솔 내부 API (aDR 드릴/전환용, 4430 포트) =====
# janus : SCP_USER/SCP_PASS로 받은 OpenAPI 토큰을 콘솔에도 사용 (01 --console로 동작 확인)
# manual: 브라우저 쿠키 aCMPAuthToken / CSRFPreventionToken 값을 직접 입력 (테스트용, 세션 만료됨)
CONSOLE_TOKEN_SOURCE=janus
CONSOLE_PORT=4430
CONSOLE_TOKEN=
CONSOLE_CSRF=
