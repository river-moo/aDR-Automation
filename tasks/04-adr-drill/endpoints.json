{
  "_comment": [
    "SCP 6.11.3 콘솔 내부 API 정의. 드릴·전환은 공식 OpenAPI에 없고 콘솔(https://SCP:4430/admin/...)에 있다.",
    "2026-11-28 랩(SCP 6.11.3) 실측 검증: drill_start, drill_cleanup, clear_state (verified=true)",
    "failover/failback 은 미확인(TODO) - 확인 전에는 실행 거부됨",
    "치환 변수: ${rp_id} 복구 계획 ID, ${rp_name} 이름, ${project_id}, ${drlog_id} 현재 드릴 작업 ID(status.drlog_id), ${drlog_root_id}",
    "api: console(4430, 기본) | openapi(443 /janus)",
    "body_builder=drill: 드릴 본문을 GET /admin/view/dr-server-list 값으로 자동 생성",
    "require_state: 실행 전 계획 상태(status.state) 조건 / wait: 실행 후 기다릴 상태 (action 지정 시 status.action도 일치)",
    "verified: 랩에서 동작 확인 후에만 true. false인 단계가 있으면 --execute 거부",
    "SCP 버전이 바뀌면 다시 확인할 것 (docs/API-MAP.md)"
  ],
  "endpoints": {
    "drill_start": {
      "api": "console",
      "method": "POST",
      "path": "/admin/dr/rps/drill",
      "body_builder": "drill",
      "require_state": [
        "ready"
      ],
      "wait": {
        "until_state": [
          "finish"
        ],
        "action": "drill"
      },
      "verified": true
    },
    "drill_cleanup": {
      "api": "console",
      "method": "DELETE",
      "path": "/admin/dr/rps/${rp_id}/drill/${drlog_id}",
      "body": {
        "rp_id": "${rp_id}",
        "drlog_id": "${drlog_id}"
      },
      "require_state": [
        "finish",
        "failed",
        "failure"
      ],
      "wait": {
        "until_state": [
          "ready",
          "finish"
        ]
      },
      "verified": true
    },
    "failover": {
      "api": "console",
      "method": "TODO",
      "path": "TODO",
      "body": {},
      "require_state": [
        "ready"
      ],
      "wait": {
        "until_state": [
          "finish"
        ]
      },
      "verified": false
    },
    "failback": {
      "api": "console",
      "method": "TODO",
      "path": "TODO",
      "body": {},
      "wait": {
        "until_state": [
          "finish",
          "ready"
        ]
      },
      "verified": false
    },
    "clear_state": {
      "api": "console",
      "method": "PUT",
      "path": "/admin/dr/rps/state/transform",
      "body": {
        "rps": [
          {
            "rp_id": "${rp_id}"
          }
        ]
      },
      "wait": {
        "until_state": [
          "ready"
        ]
      },
      "verified": true,
      "require_state": [
        "finish",
        "failed",
        "failure"
      ]
    }
  }
}
