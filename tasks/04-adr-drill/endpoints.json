{
  "_comment": [
    "SCP 6.11.3: 드릴·전환 실행 API는 콘솔(https://SCP:4430/admin/...)에 있고 복구 계획 단위로 동작한다.",
    "Task 02 캡처(또는 Copy as cURL)로 path/method/body를 채운다.",
    "치환 변수: ${rp_id} 복구 계획 ID, ${rp_name} 이름, ${project_id} 프로젝트 ID",
    "api: console(4430, 기본) | openapi(443 /janus)",
    "require_state: 실행 전 복구 계획 상태 조건 (dr-rp-list status.state)",
    "wait: 실행 후 dr-rp-list 상태가 until_state가 될 때까지 대기 (action이 있으면 status.action도 일치해야 함)",
    "verified: 랩에서 단독 호출로 동작 확인 후에만 true (false면 실행 거부)",
    "SCP 6.11.3 콘솔 JS(모듈 46667)에서 확인: 시작은 PUT /admin/dr/rps/state/transform {rps:[...]}, 종료는 DELETE /admin/dr/rps/{rp_id}/drill/{drlog_id}",
    "${drlog_id}: dr-rp-list status.drlog_id (현재 드릴 작업 ID)",
    "6.11.3 실측(dr/drlogs): 드릴 action=drill(약 10분), 테스트 종료 action=drill_clean(약 1분, 드릴의 하위 작업)",
    "clear_state: 콘솔이 테스트 종료 후 'Change DR state'로 부르는 상태 정리 API (finish/failure -> ready)"
  ],
  "endpoints": {
    "drill_start": {
      "api": "console",
      "method": "TODO",
      "path": "TODO: disasterDrill URL (모듈 262923)",
      "body": {
        "drill": {
          "rps": [
            {
              "rp_id": "${rp_id}",
              "servers": "TODO: pg_id, server_id, protection_id, src_clusters, des_clusters, recovery_storage_id"
            }
          ],
          "need_sync": 0,
          "enable_resource_reserve": 0
        }
      },
      "require_state": [
        "ready"
      ],
      "wait": {
        "until_state": [
          "finish"
        ],
        "action": "drill"
      },
      "verified": false
    },
    "drill_cleanup": {
      "api": "console",
      "method": "DELETE",
      "path": "/admin/dr/rps/${rp_id}/drill/${drlog_id}",
      "body": {
        "rp_id": "${rp_id}",
        "drlog_id": "${drlog_id}"
      },
      "require_state": [
        "finish"
      ],
      "wait": {
        "until_state": [
          "ready",
          "finish"
        ]
      },
      "verified": false
    },
    "failover": {
      "api": "console",
      "method": "TODO",
      "path": "TODO",
      "body": {},
      "require_state": [
        "ready"
      ],
      "wait": {
        "until_state": [
          "finish"
        ]
      },
      "verified": false
    },
    "failback": {
      "api": "console",
      "method": "TODO",
      "path": "TODO",
      "body": {},
      "wait": {
        "until_state": [
          "finish",
          "ready"
        ]
      },
      "verified": false
    },
    "clear_state": {
      "api": "console",
      "method": "PUT",
      "path": "/admin/dr/rps/state/transform",
      "body": {
        "rps": [
          {
            "rp_id": "${rp_id}"
          }
        ]
      },
      "wait": {
        "until_state": [
          "ready"
        ]
      },
      "verified": false
    }
  }
}
