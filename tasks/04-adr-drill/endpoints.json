{
  "_comment": [
    "SCP 6.11.3: 드릴·전환 실행 API는 콘솔(https://SCP:4430/admin/...)에 있고 복구 계획 단위로 동작한다.",
    "Task 02 캡처(또는 Copy as cURL)로 path/method/body를 채운다.",
    "치환 변수: ${rp_id} 복구 계획 ID, ${rp_name} 이름, ${project_id} 프로젝트 ID",
    "api: console(4430, 기본) | openapi(443 /janus)",
    "require_state: 실행 전 복구 계획 상태 조건 (dr-rp-list status.state)",
    "wait: 실행 후 dr-rp-list 상태가 until_state가 될 때까지 대기 (action이 있으면 status.action도 일치해야 함)",
    "verified: 랩에서 단독 호출로 동작 확인 후에만 true (false면 실행 거부)"
  ],
  "endpoints": {
    "drill_start": {
      "api": "console",
      "method": "POST",
      "path": "/admin/TODO/${rp_id}",
      "body": {},
      "require_state": ["ready"],
      "wait": {"until_state": ["finish"], "action": "drill"},
      "verified": false
    },
    "drill_cleanup": {
      "api": "console",
      "method": "POST",
      "path": "/admin/TODO/${rp_id}",
      "body": {},
      "require_state": ["finish"],
      "wait": {"until_state": ["ready"]},
      "verified": false
    },
    "failover": {
      "api": "console",
      "method": "POST",
      "path": "/admin/TODO/${rp_id}",
      "body": {},
      "require_state": ["ready"],
      "wait": {"until_state": ["finish"]},
      "verified": false
    },
    "failback": {
      "api": "console",
      "method": "POST",
      "path": "/admin/TODO/${rp_id}",
      "body": {},
      "wait": {"until_state": ["finish", "ready"]},
      "verified": false
    }
  }
}
