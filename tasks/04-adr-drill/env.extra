
# ===== Task 04 =====
# 기본 복구 계획 (이름 또는 ID). 지정하면 -p 생략 가능, trigger.sh/webhook은 이 값을 사용
ADR_PLAN=
# 드릴/전환 후 확인할 서비스 (DR 사이트 쪽 IP:포트, 쉼표로 구분). 비우면 확인 생략
# 예: VERIFY_TARGETS=10.20.0.11:22,10.20.0.12:443
VERIFY_TARGETS=
VERIFY_TIMEOUT=5
# 드릴 옵션: 1이면 드릴 전 데이터 동기화 / 리소스 예약
DRILL_NEED_SYNC=0
DRILL_RESOURCE_RESERVE=0
# SCP 작업 완료 대기 (초)
TASK_TIMEOUT=3600
TASK_POLL_INTERVAL=10
# 내부 API 정의 파일 (비우면 이 폴더의 endpoints.json)
ENDPOINTS_FILE=

# ===== 트리거 (trigger.sh / webhook.py) =====
# 실행 로그 위치 (비우면 이 폴더의 logs/), 보관 일수
LOG_DIR=
LOG_KEEP_DAYS=30
# 결과 알림 웹훅 (비우면 알림 없음). 형식: slack | mattermost | teams | telegram | generic
NOTIFY_WEBHOOK=
NOTIFY_FORMAT=generic
# telegram 형식일 때만: NOTIFY_WEBHOOK=https://api.telegram.org/bot<토큰>/sendMessage
NOTIFY_CHAT_ID=
# 웹훅 수신기 (webhook.py). 토큰은 반드시 긴 임의 문자열로 (예: openssl rand -hex 24)
WEBHOOK_BIND=0.0.0.0
WEBHOOK_PORT=8780
WEBHOOK_TOKEN=
# 웹훅으로 허용할 동작 (failover/failback은 넣지 않는 것을 권장)
WEBHOOK_ALLOWED=drill,cleanup,clear
